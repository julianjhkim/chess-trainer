# Copy to .env (gitignored) and fill in.

# Lichess API token, required for the opening explorer (masters database).
# Create one at https://lichess.org/account/oauth/token/create
# No scopes need to be selected. Value looks like lip_xxxxxxxxxxxxxxxx
LICHESS_TOKEN=

# Your chess.com username, required for fetching your games (no default).
CHESS_TRAINER_CHESSCOM_USERNAME=

# --- Optional overrides (defaults shown) ---
#CHESS_TRAINER_STOCKFISH_PATH=/opt/homebrew/bin/stockfish
#CHESS_TRAINER_ENGINE_DEPTH=20
#CHESS_TRAINER_HOST=127.0.0.1
#CHESS_TRAINER_PORT=8787
#CHESS_TRAINER_DB=~/.local/share/chess-trainer/chess_trainer.db
#CHESS_TRAINER_TIMEZONE=Asia/Seoul
