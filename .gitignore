# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtualenvs (we use conda env `chess`, but just in case) ---
.venv/
venv/
env/

# --- Testing / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Application data (SQLite DB + WAL/SHM sidecars) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Anchored to the repo root: a bare `data/` would also swallow tests/data/,
# which holds committed PGN fixtures the suite needs.
/data/

# --- Node (dev-only tooling: vendoring chessground + the frontend smoke test) ---
# package-lock.json IS committed: it records exactly which chessground version
# produced the vendored bundle in frontend/vendor/.
node_modules/
npm-debug.log*

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Editors ---
.vscode/
.idea/
*.swp
